generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  projects Project[]

  subscription Subscription?
  usageRecords UsageRecord[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Project {
  id        String   @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos Video[]
}

model Video {
  id               String      @id @default(cuid())
  projectId        String
  originalFilename String
  storagePath      String?
  duration         Float?
  status           VideoStatus @default(UPLOADING)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transcription Transcription?
  clips         Clip[]
  analysisCache AnalysisCache[]
}

model Transcription {
  id        String   @id @default(cuid())
  videoId   String   @unique
  text      String
  segments  Json
  createdAt DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model Clip {
  id         String     @id @default(cuid())
  videoId    String
  startTime  Float
  endTime    Float
  score      Float?
  reason     String?
  title      String?
  status     ClipStatus @default(PENDING)
  outputPath String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

/// Caches OpenAI clip-suggestion results per (video, transcript content,
/// model, analyzer/prompt version), so repeated requests for an unchanged
/// transcript don't re-pay for an OpenAI call. Keyed by a content hash of
/// the transcript, not just videoId, so an edited/re-transcribed video
/// naturally misses the cache instead of serving stale suggestions.
model AnalysisCache {
  id               String   @id @default(cuid())
  videoId          String
  transcriptHash   String
  model            String
  analyzerVersion  String
  suggestions      Json
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, transcriptHash, model, analyzerVersion])
}

model Plan {
  id                    String   @id @default(cuid())
  key                   String   @unique
  name                  String
  maxVideosPerMonth     Int
  maxMinutesPerMonth    Int
  maxAiAnalysesPerMonth Int
  maxClipsPerMonth      Int
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String             @unique
  planId    String
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

model UsageRecord {
  id               String    @id @default(cuid())
  userId           String
  type             UsageType
  amount           Int       @default(1)
  periodStart      DateTime
  idempotencyKey   String    @unique
  videoId          String?
  clipId           String?
  analysisCacheId  String?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, periodStart])
}

enum UsageType {
  VIDEO_UPLOAD
  TRANSCRIPTION_MINUTES
  AI_ANALYSIS
  CLIP_GENERATED
}

enum VideoStatus {
  UPLOADING
  UPLOADED
  TRANSCRIBING
  ANALYZING
  GENERATING
  COMPLETED
  FAILED
  /// Upload succeeded (file on disk, Video row exists) but transcription was
  /// never started because it would exceed the user's TRANSCRIPTION_MINUTES
  /// quota for this period. Distinct from FAILED so the UI can tell "your
  /// plan's limit" apart from "something broke".
  QUOTA_EXCEEDED
}

enum ClipStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}
